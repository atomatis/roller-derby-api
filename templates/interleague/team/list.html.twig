{% extends 'body.html.twig' %}

{# lcdp = "la croisé des platine" prefix #}
{# itl = "interleague" prefix #}

{% set route = constant('App\\Action\\Interleague\\Team\\ListAction::ROUTE_NAME') %}

{% block title %}{{ 'teams'|trans }} ({{ teamContainer.total }}){% endblock %}

{# body #}
    {# header #}
    {% block asidebefore %}
        <aside class="lcdp-aside-left">
            <h2>Filtres</h2>
            <form>
                <h3>Localisation</h3>
            </form>
        </aside>
    {% endblock %}
    {% block content %}
        <main id="lcdp-itl-list-team" class="lcdp-content">
            <h1>{{ 'teams'|trans }} ({{ teamContainer.total }})</h1>
            <div class="lcdp-scroll">
                {% for sorting, teams in teamContainer.teams %}
                    <section>
                        <h2>{{ sorting }} ({{ teams|length }})</h2>
                        <section class="lcdp-article-container">
                            {% for team in teams %}
                                {% include 'interleague/team/_team_card.html.twig' with {'teamInfo': team.cities|join(', ') } %}
                            {% endfor %}
                        </section>
                    </section>
                {% endfor %}
            </div>
        </main>
    {% endblock %}
    {# asideafter #}
    {# block footer #}
{# /body #}
