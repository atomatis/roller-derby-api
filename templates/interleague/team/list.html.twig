{% extends 'body.html.twig' %}

{% set route = constant('App\\Action\\Interleague\\Team\\ListAction::ROUTE_NAME') %}

{% block title %}{{ 'teams'|trans }} ({{ teamContainer.total }}){% endblock %}

{# body #}
    {# header #}
    {% block asidebefore %}
        <aside class="lcdp-aside-left">
            <h2>Filtres</h2>
            <form>
                <h3>Localisation</h3>
            </form>
        </aside>
    {% endblock %}
    {% block content %}
        <main id="lcdp-interleague-list-team" class="lcdp-content">
            <h1>{{ 'teams'|trans }} ({{ teamContainer.total }})</h1>
            {% for sorting, teams in teamContainer.teams %}
            <section>
                <h2>{{ sorting }} ({{ teams|length }})</h2>
                <section class="lcdp-article-container">
                    {% for team in teams %}
                        <article class="lcdp-itl-team-list-item">
{#                            <img class="lcdp-logo-team" alt="logo team" src="https://placehold.co/48x48">#}
                            <img class="lcdp-logo-team" alt="logo team" src="https://placekittens.com/48/48">
                            <header>
                                {% if team.wftda %}<span><img class="lcdp-logo-wtda" alt="logo wtda" src="{{ asset('images/logo_wtfda.png') }}"></span>{% endif %}
                                {% if team.mrda %}<span><img class="lcdp-logo-wtda" alt="logo wtda" src="{{ asset('images/logo_mrda.jpg') }}"></span>{% endif %}
                                <h3 class="{% if team.level != null %}{{ team.level }}{% endif %}">{{ team.pronoun }}{{ team.name }}</h3>

                            </header>
                            <ul class="lcdp-info">
                                <li>{{ team.cities|join(', ') }}</li>
                                {% if team.type != 'A' %}<li class="lcdp-team-type">{{ team.type }}</li>{% endif %}
                            </ul>
                            <button>+</button>
                        </article>
                    {% endfor %}
                </section>
            </section>
            {% endfor %}
        </main>
    {% endblock %}
    {# asideafter #}
    {# block footer #}
{# /body #}
