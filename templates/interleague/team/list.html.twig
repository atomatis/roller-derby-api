{% extends 'body.html.twig' %}

{% set route = constant('App\\Action\\Interleague\\Team\\ListAction::ROUTE_NAME') %}

{% block title %}{{ 'teams'|trans }} ({{ teamContainer.total }}){% endblock %}

{# body #}
    {# header #}
    {% block asidebefore %}
        <aside class="lcdp-aside-left">
            <h2>Filtres</h2>
            <form>
                <h3>Localisation</h3>
            </form>
        </aside>
    {% endblock %}
    {% block content %}
        <main>
            <nav class="lcdp-content-nav">
                <a class="active" href="{{ path(routes.getRoutes.event.list) }}">F+</a>
                <a href="{{ path(routes.getRoutes.event.list) }}">Open</a>
            </nav>
            {% for sorting, teams in teamContainer.teams %}
            <section class="content">
                <h2>{{ sorting }} ({{ teams|length }})</h2>
                <section class="lcdp-article-box">
                    {% for team in teams %}
                        <article class="lcdp-itl-team-list-item">
                            <img src="https://placehold.co/50x50">
                            <h3>{{ team.pronoun }}{{ team.name }}</h3>
                            <ul class="lcdp-cities">
                                <li>{{ team.cities|join(', ') }}</li>
                                {% if team.level != null %}<li>{{ team.level|trans }}</li>{% endif %}
                                {% if team.type != 'A' %}<li>{{ team.type }}</li>{% endif %}
                            </ul>
                            <p>.<br>.<br>.</p>
                        </article>
                    {% endfor %}
                </section>
            </section>
            {% endfor %}
        </main>
    {% endblock %}
    {# asideafter #}
    {# block footer #}
{# /body #}
