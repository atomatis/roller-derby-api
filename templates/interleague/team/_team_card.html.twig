<article class="lcdp-itl-team-card">
    {# <img class="lcdp-logo-team" alt="logo team" src="https://placehold.co/48x48">#}
    <img alt="logo {{ team.name }}" src="https://placekittens.com/48/48">
    <header>
        {% if team.wftda %}<span><img class="lcdp-logo-wftda" alt="logo wftda" src="{{ asset('images/logo_wtfda.png') }}"></span>{% endif %}
        {% if team.mrda %}<span><img class="lcdp-logo-mrda" alt="logo mrda" src="{{ asset('images/logo_mrda.jpg') }}"></span>{% endif %}
        <h3 class="{% if team.level != null %}{{ team.level }}{% endif %}">{{ team.name }}</h3>
    </header>
    <ul>
        <li>{{ teamInfo }}</li>
        {% if team.type != 'A' %}<li class="lcdp-team-type">{{ team.type }}</li>{% endif %}
    </ul>
    <a href="{{ path(routes.getRoutes.team.view, {id: team.id}) }}">>></a>
</article>
