{% extends 'body.html.twig' %}

{% block title %}{{ 'clubs'|trans }} ({{ clubContainer.total }}){% endblock %}

{# body #}
    {# block header #}
    {# block asidebefore #}
    {% block content %}
        <main>
            {% for sorting, clubs in clubContainer.clubs %}
            <section class="content">
                <h2>{{ sorting }} ({{ clubs|length }})</h2>
                <section class="lcdp-article-box">
                    {% for club in clubs %}
                        <article>
                            <a href="">
                                <img src="https://placehold.co/50x50">
                                <h3>{{ club.name }}</h3>
                            </a>
                        </article>
                    {% endfor %}
                </section>
            </section>
            {% endfor %}
        </main>
    {% endblock %}
    {# block asideafter #}
    {# block footer #}
{# /body #}
