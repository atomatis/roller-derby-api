{% extends 'body.html.twig' %}

{# body #}
    {# block header #}
    {% block asidebefore %}
        <aside>
            <section class="content">
                <h2>Sidebar</h2>
                <label for="select-a">Select</label>
                <select id="select-a">
                    <option>alpha</option>
                    <option>beta</option>
                    <option>omega</option>
                </select>
                <label for="input-text">Text</label>
                <input  id="input-text" type="text">
                <label for="input-file">File</label>
                <input  id="input-file" type="file">
                <label for="input-textarea">Text area</label>
                <textarea id="input-textarea"></textarea>
                <label for="input-radio-1">radio 1</label><br>
                <input type="radio" id="input-radio-1" name="input_radio" value="1">
                <label for="input-radio-2">radio 2</label><br>
                <input type="radio" id="input-radio-2" name="input_radio" value="2">
                <label for="input-radio-3">radio 3</label><br>
                <input type="radio" id="input-radio-3" name="input_radio" value="3">
                <label for="input-checkbox-1">checkbox 1</label><br>
                <input type="checkbox" id="input-checkbox-1" name="input_checkbox" value="1">
                <label for="input-checkbox-2">checkbox 2</label><br>
                <input type="checkbox" id="input-checkbox-2" name="input_checkbox" value="2">
                <label for="input-checkbox-3">checkbox 3</label><br>
                <input type="checkbox" id="input-checkbox-3" name="input_checkbox" value="3">
                <input type="submit" value="submit">
            </section>
        </aside>
    {% endblock %}

    {% block content %}
        <main>
            <section class="content">
                <h2>{{ 'integration-title'|trans }}</h2>
                <p>{{ 'lorem-ipsum-medium'|trans }}</p>
                <button>{{ 'button'|trans }}</button>
                <button class="active">{{ 'button-active'|trans }}</button>
                <button class="hover">{{ 'button-hover'|trans }}</button>
            </section>
            <section class="content">
                <h2>Titre here</h2>
                <section class="lcdp-article-box">
                    <article>
                        <a href="">
                            <img src="https://placehold.co/50x50">
                            <h3>Article 1</h3>
                        </a>
                    </article>
                    <article>
                        <a href="">
                            <img src="https://placehold.co/50x50">
                            <h3>Article 2</h3>
                        </a>
                    </article>
                    <article>
                        <a href="">
                            <img src="https://placehold.co/50x50">
                            <h3>Article 3</h3>
                        </a>
                    </article>
                    <article>
                        <a href="">
                            <img src="https://placehold.co/50x50">
                            <h3>Article 4</h3>
                        </a>
                    </article>
                </section>
            </section>
        </main>
    {% endblock %}
    {# block asideafter #}
    {# block footer #}
{# /body #}


